; Engine configuration file.
; Godot 4.7.2-stable.
config_version=5

[application]
config/name="orca class"
config/description="Star Fox-style tank shooter in a fungus-infested Korean countryside."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="fractional"

[gui]
theme/custom_font="res://assets/fonts/x10y12pxDenkiChipHangul.woff2"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[internationalization]
locale/translations=PackedStringArray("res://i18n/strings.ko.translation", "res://i18n/strings.en.translation")
locale/fallback="ko"

[rendering]
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.99, 0.95, 0.9, 1)
