func _sample(d: float, u: float) -> String:
	var h := Course.height(d, u)
	var w := Course.to_world(d, u, 1.0)
	var s := Water.surface_at(Vector3(w.x, 0.0, w.z))
	return "%.0f,%.0f,%.5f,%s,%.4f,%.4f,%d,%s" % [d, u, h, Course.ground_color(d, u, h, 0.5).to_html(false), w.x, w.z, Course.section_at(d), "-" if s == -INF else "%.3f" % s]


func test_stage_1_geography_is_unchanged() -> void:
	check_eq(SAMPLES.size(), 120, "the table covers 15 distances by 8 offsets")
	for line in SAMPLES:
		var fields := line.split(",")
		check_eq(_sample(float(fields[0]), float(fields[1])), line, "sample at d=%s u=%s" % [fields[0], fields[1]])
